NODE_ENV=development
PORT=3333
# Caminho do arquivo SQLite (relativo à pasta backend)
DATABASE_URL="file:./data/bruvet.db"
DATA_DIR=./data
# Origens liberadas no CORS, separadas por vírgula. Vazio libera todas.
CORS_ORIGIN=

# Segredo das sessões (mín. 32 caracteres). Vazio = gerado e salvo em DATA_DIR/.jwt-secret
JWT_SECRET=
SESSION_HOURS=12
# true quando servido por HTTPS
COOKIE_SECURE=false

# Admin criado quando o banco não tem usuários. Sem senha = gerada e exibida no log.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@bruvet.local
ADMIN_PASSWORD=admin12345
