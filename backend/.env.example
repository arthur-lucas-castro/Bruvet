NODE_ENV=development
PORT=3333
# Postgres (o docker-compose.dev.yml sobe um em localhost:5432)
DATABASE_URL="postgresql://bruvet:bruvet@localhost:5432/bruvet"
# Opcional: conexão direta, sem pooler, usada pelas migrations (Neon fornece as duas)
# DATABASE_URL_UNPOOLED=
DATA_DIR=./data
# Origens liberadas no CORS, separadas por vírgula. Vazio libera todas.
CORS_ORIGIN=

# Segredo das sessões (mín. 32 caracteres). Vazio = gerado e salvo em DATA_DIR/.jwt-secret
# (obrigatório na Vercel)
JWT_SECRET=
SESSION_HOURS=12
# true quando servido por HTTPS
COOKIE_SECURE=false

# Admin criado quando o banco não tem usuários. Sem senha = gerada e exibida no log.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@bruvet.local
ADMIN_PASSWORD=admin12345
